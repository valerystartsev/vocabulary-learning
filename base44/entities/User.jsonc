{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin",
        "teacher"
      ],
      "default": "user",
      "description": "User role in the application"
    },
    "isFinancialUniversity": {
      "type": "boolean",
      "default": false,
      "description": "Whether the student studies at Financial University \u2014 enables teacher tracking"
    },
    "displayName": {
      "type": "string",
      "description": "Student display name for teacher identification and UI"
    },
    "progress": {
      "type": "object",
      "description": "Course progress summary metrics \u2014 read by teacher dashboard",
      "properties": {
        "overallPercent": {
          "type": "number"
        },
        "unit1Percent": {
          "type": "number"
        },
        "unit2Percent": {
          "type": "number"
        },
        "wordsLearnedCount": {
          "type": "number"
        },
        "weakWordsCount": {
          "type": "number"
        },
        "testsDoneCount": {
          "type": "number"
        },
        "completedExercisesCount": {
          "type": "number"
        },
        "mediaCompleted": {
          "type": "number"
        },
        "exerciseScores": {
          "type": "object",
          "description": "Latest score per exercise ID"
        },
        "exerciseBestScores": {
          "type": "object",
          "description": "Best score per exercise ID"
        },
        "exerciseAttempts": {
          "type": "object",
          "description": "Attempt count per exercise ID"
        },
        "scenarioScores": {
          "type": "object"
        },
        "crosswordScores": {
          "type": "object"
        },
        "learnedWords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weakWords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lastActiveAt": {
          "type": "string"
        }
      }
    },
    "savedProgress": {
      "type": "object",
      "description": "Full raw progress snapshot \u2014 used to restore state on new device or after localStorage is cleared",
      "properties": {
        "learnedWords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weakWords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completedExercises": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exerciseScores": {
          "type": "object"
        },
        "exerciseBestScores": {
          "type": "object"
        },
        "exerciseAttempts": {
          "type": "object"
        },
        "completedSections": {
          "type": "object"
        },
        "totalTestScores": {
          "type": "object"
        },
        "completedMedia": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mediaTaskScores": {
          "type": "object"
        },
        "vocabRadar": {
          "type": "object"
        },
        "lastOpenedUnit": {
          "type": "number"
        },
        "lastOpenedSection": {
          "type": "string"
        },
        "scenarioScores": {
          "type": "object"
        },
        "crosswordScores": {
          "type": "object"
        },
        "mediaQuestScores": {
          "type": "object"
        }
      }
    }
  },
  "required": []
}